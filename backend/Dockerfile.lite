# 轻量版 Dockerfile - 移除 RAG 依赖，使用 Ollama
FROM docker.m.daocloud.io/library/python:3.11-slim

WORKDIR /app

# 安装系统依赖 (MySQL 客户端等)
RUN apt-get update && apt-get install -y \
    default-libmysqlclient-dev \
    pkg-config \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# 安装 Python 依赖（使用清华镜像源加速）
COPY requirements-lite.txt .
RUN pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple -r requirements-lite.txt

# 复制代码
COPY . .

# 确保 init_db.py 可执行
RUN chmod +x init_db.py

# 暴露端口
EXPOSE 8000

# 启动命令
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
