# Joe AI Writer 配置文件
# 复制此文件为 .env 并填写你的配置

# ========== 基础配置 ==========
APP_NAME=Joe AI Writer
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production

# ========== 数据库配置 ==========
# MySQL (默认 - 推荐用于生产环境)
# 请确保本地 MySQL 已安装并创建了数据库
# 创建数据库: CREATE DATABASE joe_writer CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/joe_writer?charset=utf8mb4

# MySQL 连接池配置
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600

# SQLite (开发测试用)
# DATABASE_URL=sqlite:///./joe_writer.db

# PostgreSQL (可选)
# DATABASE_URL=postgresql://user:password@localhost/joe_writer

# ========== AI 模型配置 ==========
# 选择 AI 提供商: openai, deepseek, siliconflow, custom
# 默认使用 DeepSeek，中文表现优秀
AI_PROVIDER=deepseek

# 通用参数
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=4096

# --- DeepSeek 配置 (默认) ---
# DeepSeek AI - 中文写作表现优秀，性价比高
# 获取 API Key: https://platform.deepseek.com
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# --- OpenAI 配置 ---
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4

# --- SiliconFlow 配置 ---
# SILICONFLOW_API_KEY=your-siliconflow-api-key
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3

# --- 自定义 API 配置 ---
# CUSTOM_API_KEY=your-custom-api-key
# CUSTOM_BASE_URL=https://your-api-endpoint.com/v1
# CUSTOM_MODEL=your-model-name

# ========== JWT 配置 ==========
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
