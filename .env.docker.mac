# ============================================
# macOS 本地 Docker 环境变量模板
# 复制为 .env 后按需修改:
#   cp .env.docker.mac .env
# ============================================

# ---------- 完整栈（docker-compose.mac.yml）用的 MySQL 容器配置 ----------
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=joe_writer
MYSQL_USER=joewriter
MYSQL_PASSWORD=joewriter123

# ---------- 仅后端+前端、连 Mac 本机 MySQL 时填写（docker-compose.mac.local-db.yml）----------
LOCAL_MYSQL_USER=root
LOCAL_MYSQL_PASSWORD=your-mysql-password
LOCAL_MYSQL_DATABASE=joe_writer
LOCAL_MYSQL_PORT=3306

# ---------- AI（至少配置一个）----------
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat

SECRET_KEY=your-secret-key-change-in-production
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=4096
