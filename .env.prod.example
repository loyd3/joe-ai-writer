# ============================================
# 墨心 AI 写作工具 - 生产环境配置
# ============================================
# 复制此文件为 .env.prod 并修改配置
# ============================================

# Docker 镜像配置
DOCKER_REGISTRY=your-dockerhub-username
VERSION=latest

# 服务端口
BACKEND_PORT=9000
FRONTEND_PORT=8080
SERVER_HOST=localhost

# ============================================
# 数据库配置（请修改密码！）
# ============================================
MYSQL_ROOT_PASSWORD=changeme_root_password_123
MYSQL_DATABASE=joe_writer
MYSQL_USER=joewriter
MYSQL_PASSWORD=changeme_db_password_456

# 连接池配置
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# ============================================
# AI 模型配置
# ============================================
AI_PROVIDER=custom
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=4096

# Ollama 配置
# 如果 Ollama 在宿主机运行，使用 host.docker.internal
# 如果 Ollama 在另一个容器运行，使用容器名
CUSTOM_API_KEY=ollama
CUSTOM_BASE_URL=http://host.docker.internal:11434/v1
CUSTOM_MODEL=qwen3:30b

# 其他 AI 提供商配置（可选）
# OPENAI_API_KEY=your_openai_key
# DEEPSEEK_API_KEY=your_deepseek_key
# SILICONFLOW_API_KEY=your_siliconflow_key

# ============================================
# 应用安全配置（请修改！）
# ============================================
SECRET_KEY=your-secret-key-change-this-in-production-xyz123

# JWT 配置
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ============================================
# 高级配置
# ============================================
# 限流配置
RATE_LIMIT_AI=10/minute
RATE_LIMIT_GENERAL=60/minute

# CORS 配置（多个来源用逗号分隔）
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
